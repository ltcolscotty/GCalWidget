<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GCaLink.ViewWindows.WeekView.WeekViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GCaLink Week View">
    <Grid Padding="16" RowDefinitions="Auto,*" Background="#202020">
        <TextBlock Text="Coming Up" FontSize="24" FontWeight="SemiBold" Foreground="White" />
        <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="DaysList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,14" Spacing="8">
                            <Grid ColumnDefinitions="56,*">
                                <TextBlock Text="{Binding Day}" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Grid.Column="1" Text="{Binding Date}" Foreground="#BBBBBB" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Events}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Padding="12" Background="#3A3A3A" CornerRadius="10">
                                            <Grid ColumnDefinitions="78,*">
                                                <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Foreground="#7BCBFF" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No events" Foreground="#BBBBBB" Visibility="{Binding EmptyStateVisibility}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
