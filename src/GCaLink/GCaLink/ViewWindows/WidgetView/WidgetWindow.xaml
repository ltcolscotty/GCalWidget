<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GCaLink.ViewWindows.WidgetView.WidgetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:GCaLink.ViewWindows.WidgetView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GCaLink Widget"
    >

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.Resources>
            <DataTemplate x:Key="SettingsSectionHeaderTemplate">
                <TextBlock Text="{Binding}"
                           FontSize="18"
                           FontWeight="Bold" />
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- TabView -->
        </Grid.RowDefinitions>

        <!-- Header (logo + title) -->
        <Grid Grid.Row="0" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Logo -->
            <Image Source="Assets/logo.png"
               Width="32"
               Height="32"
               VerticalAlignment="Center"/>

            <!-- Title -->
            <TextBlock Text="GCaLink"
                   Grid.Column="1"
                   VerticalAlignment="Center"
                   Margin="10,10,10,0"
                   FontSize="30"
                   FontWeight="SemiBold"/>

        </Grid>

        <!-- Tabs -->
        <muxc:TabView
        Grid.Row="1"
        IsAddTabButtonVisible="False"
        TabWidthMode="SizeToContent">

            <muxc:TabViewItem Header="Main" IsClosable="False">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="16" Spacing="8" HorizontalAlignment="Stretch">
                        <muxc:Expander Header="Sources"
                                      HeaderTemplate="{StaticResource SettingsSectionHeaderTemplate}"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8" Padding="8,4,8,8">
                                <CheckBox x:Name="EnableGoogle" Content="Google Calendar" Checked="GoogleEnabled" Unchecked="GoogleDisabled"/>
                                <CheckBox x:Name="EnableCanvas" Content="Canvas Calendar" Checked="CanvasEnabled" Unchecked="CanvasDisabled"/>
                            </StackPanel>
                        </muxc:Expander>
                        <muxc:Expander Header="Views"
                                      HeaderTemplate="{StaticResource SettingsSectionHeaderTemplate}"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8" Padding="8,4,8,8">
                                <ComboBox x:Name="PrimaryViewSelector"
                                          Header="Calendar view"
                                          HeaderTemplate="{StaticResource SettingsSectionHeaderTemplate}"
                                          SelectionChanged="PrimaryViewChanged"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="TodoView"/>
                                    <ComboBoxItem Content="DayView"/>
                                    <ComboBoxItem Content="WeekView"/>
                                </ComboBox>
                                <CheckBox x:Name="EnablePrimaryView"
                                          Content="Enable calendar view"
                                          Checked="PrimaryViewEnabled"
                                          Unchecked="PrimaryViewDisabled"/>
                                <CheckBox x:Name="EnablePinnedView"
                                          Content="Pin calendar view"
                                          Checked="PinnedViewEnabled"
                                          Unchecked="PinnedViewDisabled"/>
                            </StackPanel>
                        </muxc:Expander>
                        <muxc:Expander Header="Background style"
                                      HeaderTemplate="{StaticResource SettingsSectionHeaderTemplate}"
                                      IsExpanded="False"
                                      HorizontalAlignment="Stretch"
                                      HorizontalContentAlignment="Stretch">
                            <muxc:RadioButtons x:Name="BkgStyleRadioSettings"
                                               FontSize="20"
                                               SelectedIndex="0"
                                               SelectionChanged="BkgStyleChanged"
                                               Padding="8,4,8,8">
                                <x:String>Solid</x:String>
                                <x:String>Mica</x:String>
                                <x:String>Acrylic</x:String>
                            </muxc:RadioButtons>
                        </muxc:Expander>
                    </StackPanel>
                </ScrollViewer>
            </muxc:TabViewItem>

            <muxc:TabViewItem Header="Google" IsClosable="False">
                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="GoogleSignedOutPanel">
                            <Button x:Name="GoogleSI"
                                    Click="GoogleSIClick"
                                    Padding="0"
                                    Margin="0">
                                <Image Source="ms-appx:///Assets/google-si-neutral.png"
                                       Width="108"
                                       Height="24"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                            </Button>
                        </StackPanel>
                        <Border x:Name="GoogleAccountCard"
                                Visibility="Collapsed"
                                Padding="12"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Grid ColumnSpacing="12" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <Border Width="40" Height="40" CornerRadius="20">
                                    <Image x:Name="GoogleProfileImage" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock x:Name="GoogleProfileNameText" FontWeight="SemiBold" />
                                    <TextBlock x:Name="GoogleProfileEmailText" Opacity="0.7" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="Sign out" Click="GoogleSignOutClick" />
                                    <Button Content="Switch account" Click="GoogleSwitchAccountClick" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="GoogleConnectionStatus"
                                   Grid.Row="1"
                                   Margin="0,32,0,0"
                                   Text="Not connected"
                                   TextWrapping="Wrap" />
                    </Grid>
                    <Grid Grid.Row="1" >
                        <ListView ItemsSource="{Binding GSources}">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:WidgetWindow">
                                    <Border Background="{Binding BackgroundBrush}">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="{Binding SourceName}" FontSize="18" FontWeight="SemiBold"/>

                                            <ColorPicker x:Name="SourceColorPicker" />

                                            <Button Content="Choose background image" Click="ChooseBackgroundImageClick" />

                                            <TextBlock Text="{Binding BackgroundImageName}" Opacity="0.7" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <Grid Grid.Row="2" Padding="0,10">
                        <muxc:Button x:Name="RefreshGoogleSourcesButton"
                                     Content="Refresh Google Sources"
                                     Click="RefreshGoogleSources"
                                     Visibility="Collapsed"/>
                    </Grid>
                </Grid>
            </muxc:TabViewItem>

            <muxc:TabViewItem Header="Canvas" IsClosable="False">
                <Grid Padding="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Padding="0,10">
                        <muxc:Button Content="Refresh Canvas Sources" Click="RefreshCanvasSources"/>
                    </Grid>
                    <muxc:TextBox x:Name="CanvasCalLinkInput"
                                  Header="Canvas calendar link"
                                  HorizontalAlignment="Left"
                                  PlaceholderText="https://canvas.asu.edu/feeds/calendars/---.ics"
                                  Width="300"
                                  Grid.Row="1"/>
                    <Grid Grid.Row="2" Padding="0,10">
                        <muxc:Button Click="CanvasSaveClick">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Image Source="ms-appx:///Assets/canvas-lms.png"
                                       Width="20"
                                       Height="20"
                                       Stretch="Uniform" />
                                <TextBlock Text="Link canvas calendar"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </muxc:Button>
                    </Grid>
                    <TextBlock x:Name="CanvasSaveStatus" Grid.Row="3" TextWrapping="Wrap" />
                </Grid>
            </muxc:TabViewItem>

        </muxc:TabView>
    </Grid>
</Window>
