<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GCaLink.ViewWindows.DayView.DayViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:GCaLink.ViewWindows.DayView"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GCaLink Day View">

    <Grid Background="#202020">

        <Border
            Margin="12"
            Padding="20"
            Background="#2B2B2B"
            CornerRadius="16">

            <StackPanel>

                <TextBlock
                    x:Name="DayText"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"/>

                <TextBlock
                    x:Name="DateText"
                    Margin="0,2,0,18"
                    FontSize="30"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Text="Today's Schedule"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#DDDDDD"/>

                <ListView
                    x:Name="ScheduleList"
                    Margin="0,12,0,0"
                    Background="Transparent"
                    BorderThickness="0">

                    <ListView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Margin="0,0,0,10"
                                Padding="12"
                                Background="#3A3A3A"
                                CornerRadius="10">

                                <Grid ColumnDefinitions="70,*">

                                    <TextBlock
                                        Text="{Binding Time}"
                                        FontWeight="SemiBold"
                                        Foreground="#7BCBFF"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            Foreground="White"/>

                                        <TextBlock
                                            Text="{Binding Location}"
                                            FontSize="12"
                                            Foreground="#BBBBBB"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ListView.ItemTemplate>

                </ListView>

            </StackPanel>

        </Border>

    </Grid>

</Window>