<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GCaLink.ViewWindows.TodoView.TodoViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GCaLink Todo View">
    <Grid Padding="16" RowDefinitions="Auto,*">
        <TextBlock Text="Todo list" FontSize="24" FontWeight="SemiBold" />
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <ListView x:Name="EventsList" ItemsSource="{x:Bind Events}" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="12" Background="{Binding BackgroundBrush}" CornerRadius="8">
                            <Grid ColumnDefinitions="88,*">
                                <TextBlock Text="{Binding Time}" Foreground="#7BCBFF" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" TextWrapping="Wrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock x:Name="EmptyState"
                       Text="No events in the next 24 hours."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
