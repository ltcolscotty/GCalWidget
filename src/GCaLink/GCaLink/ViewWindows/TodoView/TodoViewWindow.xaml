<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GCaLink.ViewWindows.TodoView.TodoViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GCaLink Todo View">
    <Grid Padding="16" RowDefinitions="Auto,*" Background="#202020">
        <TextBlock Text="Todo list" FontSize="24" FontWeight="SemiBold" Foreground="White" />
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="EventsList" ItemsSource="{x:Bind Events}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" Background="{Binding BackgroundBrush}" CornerRadius="10">
                                <Grid ColumnDefinitions="88,*">
                                    <TextBlock Text="{Binding Time}" FontWeight="SemiBold" Foreground="#7BCBFF" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock x:Name="EmptyState"
                       Text="No events in the next 24 hours."
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#BBBBBB" />
        </Grid>
    </Grid>
</Window>
