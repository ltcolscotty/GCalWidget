<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GCaLink.ViewWindows.SettingsView.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GCaLink.ViewWindows.SettingsView"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GCaLink Settings">

    <ScrollViewer>
        <StackPanel Spacing="16" Padding="32" MaxWidth="560">
            <TextBlock Text="Google Calendar" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock Text="Connect a Google Calendar account to show upcoming events in the widget."
                       TextWrapping="Wrap" />

            <TextBlock x:Name="CredentialsStatusText" Text="OAuth client is included with the app."
                       TextWrapping="Wrap" Opacity="0.75" />

            <StackPanel x:Name="SignedOutPanel" Orientation="Horizontal" Spacing="12">
                <Button x:Name="SignInButton" Click="SignInClick" Padding="0">
                    <Image Source="ms-appx:///Assets/google-si-dark.png"
                           Width="108"
                           Height="24"
                           Stretch="UniformToFill" />
                </Button>
            </StackPanel>

            <Border x:Name="AccountCard" Visibility="Collapsed" Padding="16"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8">
                <Grid RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <Border Width="48" Height="48" CornerRadius="24">
                        <Image x:Name="ProfileImage" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="ProfileNameText" FontWeight="SemiBold" />
                        <TextBlock x:Name="ProfileEmailText" Opacity="0.7" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                                HorizontalAlignment="Right" Spacing="8">
                        <Button Content="Sign out" Click="SignOutClick" />
                        <Button Content="Switch account" Click="SwitchAccountClick" />
                    </StackPanel>
                </Grid>
            </Border>

            <TextBlock x:Name="ConnectionStatusText" Text="Not connected" TextWrapping="Wrap" />
            <CheckBox x:Name="GoogleEnabledCheckBox" Content="Use Google Calendar in the widget"
                      Checked="GoogleEnabledChecked" Unchecked="GoogleEnabledUnchecked" />
        </StackPanel>
    </ScrollViewer>
</Window>