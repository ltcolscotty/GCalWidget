<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GCaLink.ViewWindows.DayView.DayViewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:local="using:GCaLink.ViewWindows.DayView"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="GCaLink Day View">


        <Grid Padding="16" RowDefinitions="Auto,Auto,Auto,Auto,*" Background="#202020">

                <TextBlock
                    x:Name="DayText"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Foreground="White"/>

                <TextBlock
                    x:Name="DateText"
                    Grid.Row="1"
                    Margin="0,2,0,16"
                    FontSize="24"
                    FontWeight="Bold"
                    Foreground="White"/>

                <TextBlock
                    Grid.Row="2"
                    Text="Today's Schedule"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="#DDDDDD"/>

                <TextBlock
                    x:Name="EmptyState"
                    Grid.Row="3"
                    Margin="0,12,0,0"
                    Text="No events today"
                    Foreground="#BBBBBB"
                    Visibility="Collapsed"/>

                <ScrollViewer
                    Grid.Row="4"
                    Margin="0,12,0,0"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScheduleList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>

                            <Border
                                Margin="0,0,0,8"
                                Padding="12"
                                Background="{Binding BackgroundBrush}"
                                CornerRadius="10">

                                <Grid ColumnDefinitions="78,*">

                                    <TextBlock
                                        Text="{Binding Time}"
                                        FontWeight="SemiBold"
                                        Foreground="#7BCBFF"/>

                                    <StackPanel Grid.Column="1">

                                        <TextBlock
                                            Text="{Binding Title}"
                                            FontWeight="SemiBold"
                                            Foreground="White"/>

                                        <TextBlock
                                            Text="{Binding Location}"
                                            FontSize="12"
                                            Foreground="#BBBBBB"/>

                                    </StackPanel>

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

        </Grid>

</Window>